# AppLux frontend env — Vite picks up VITE_* prefixed variables.
# Copy this file to .env.local and fill in real values from your Supabase project.
#
# Without these set, the Supabase auth provider stays inert and the app runs
# against the demo localStorage store (Phase 1 / pre-MVP behaviour).

# Supabase project URL — looks like https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Anon (public) key — safe to ship to the browser; RLS enforces access.
VITE_SUPABASE_ANON_KEY=

# Demo-mode override (Phase 9). When set to "true", the StoreProvider
# exposes the seeded demo data (invoices/contracts/stores/admin lists)
# regardless of whether Supabase is configured.
#
#   unset (default) — demo data only available in DEV when Supabase
#                     env vars are missing; never in PROD.
#   true            — force demo mode on (useful for screenshotting /
#                     stakeholder previews of the UI without a live DB).
#
# In a production build (`vite build`), do NOT set this. If Supabase
# is also unconfigured, the app renders ProductionConfigError instead
# of falling through to demo data.
VITE_DEMO_MODE=

# ---------------------------------------------------------------------
# App Store readiness — external links surfaced inside the Profile
# tab. All three are optional in dev (the corresponding row hides
# when its URL is empty) but REQUIRED for any production build that
# is going to App Store / Google Play review:
#   * Privacy Policy URL — full public URL of the privacy policy.
#     Apple requires this both in App Store Connect metadata and a
#     working link inside the app (Guideline 5.1.1).
#   * Support URL — public support / help-centre page.
#   * Support Email — fallback / direct contact email. When set, the
#     in-app "Contact support" row opens a mailto: link.
# ---------------------------------------------------------------------
VITE_PRIVACY_POLICY_URL=
VITE_SUPPORT_URL=
VITE_SUPPORT_EMAIL=
