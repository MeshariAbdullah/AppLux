# AppLux frontend env — Vite picks up VITE_* prefixed variables.
# Copy this file to .env.local and fill in real values from your Supabase project.
#
# Without these set, the Supabase auth provider stays inert and the app runs
# against the demo localStorage store (Phase 1 / pre-MVP behaviour).

# Supabase project URL — looks like https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Anon (public) key — safe to ship to the browser; RLS enforces access.
VITE_SUPABASE_ANON_KEY=
