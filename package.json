{
  "name": "applux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AppLux - Arabic-first B2B2C rental contract & promissory note management platform for Saudi Arabia",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "test:pricing": "esbuild src/lib/pricing.ts --bundle --format=esm --outfile=scripts/.pricing-bundle.mjs && node --test scripts/pricing.test.mjs",
    "test:disputes": "esbuild src/lib/disputeDeadline.ts --bundle --format=esm --outfile=scripts/.dispute-deadline-bundle.mjs && node --test scripts/dispute-deadline.test.mjs",
    "test:responsive": "playwright test",
    "appstore:ar": "node appstore/render.mjs",
    "test:otp": "esbuild supabase/functions/_shared/msegat.ts --bundle --format=esm --outfile=scripts/.msegat-bundle.mjs && esbuild supabase/functions/_shared/mobile.ts --bundle --format=esm --outfile=scripts/.mobile-bundle.mjs && node --test scripts/msegat-otp.test.mjs",
    "test:registration": "esbuild src/lib/otp/flags.ts --bundle --format=esm --outfile=scripts/.otp-flags-bundle.mjs && node --test scripts/registration-otp.test.mjs",
    "test:push": "node --test scripts/push-dedupe.test.mjs",
    "test:uuid": "esbuild src/lib/displayRef.ts --bundle --format=esm --outfile=scripts/.display-ref-bundle.mjs && node --test scripts/uuid-leak.test.mjs",
    "test:settlement": "node --test scripts/settlement-cap.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.7",
    "@supabase/supabase-js": "^2.105.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
